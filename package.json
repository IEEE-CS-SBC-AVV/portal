    "gray-matter": "^4.0.3",
    "lucide-react": "^0.555.0",
    "next": "^16.2.11",
    "react": "^19.2.1",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.67.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7"
  },
  "overrides": {
    "sharp": "^0.35.3"
